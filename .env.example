# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Bot Behavior Configuration
# Comma-separated list of channel IDs where the bot should respond
WATCH_CHANNEL_IDS=123456789,987654321

# Number of ✅ reactions needed to trigger payout logging
HELPFUL_REACTION_THRESHOLD=3

# ACP Seller (Virtuals Protocol)
# When set, Alfred runs as an ACP seller agent accepting jobs from buyers
LITE_AGENT_API_KEY=     # Alfred's agent API key from ACP setup
ACP_SOCKET_URL=https://acpx.virtuals.io
ACP_API_URL=https://claw-api.virtuals.io
