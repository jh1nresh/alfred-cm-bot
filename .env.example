# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Bot Behavior Configuration
# Comma-separated list of channel IDs where the bot should respond
WATCH_CHANNEL_IDS=123456789,987654321

# Number of ✅ reactions needed to trigger payout logging
HELPFUL_REACTION_THRESHOLD=3

# ACP Seller (Virtuals Protocol)
# When set, Alfred runs as an ACP seller agent accepting jobs from buyers
LITE_AGENT_API_KEY=     # Alfred's agent API key from ACP setup
ACP_SOCKET_URL=https://acpx.virtuals.io
ACP_API_URL=https://claw-api.virtuals.io

# ─── Twitter/X Content Manager ──────────────────────────────────────────────
# Global Twitter credentials (used when no project-specific creds are set)
# Get from: https://developer.twitter.com/en/portal/dashboard
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token        # your account's access token
TWITTER_ACCESS_SECRET=your_twitter_access_secret      # your account's access token secret

# Project-specific Twitter credentials (override global per project)
# Format: TWITTER_<PROJECT_ID>_API_KEY, TWITTER_<PROJECT_ID>_API_SECRET, etc.
# These are auto-set by the ACP twitter_cm_starter / twitter_cm_pro offerings
# when a buyer provides credentials in their job requirements.
# Example: TWITTER_TWITTER_PRO_12345_MYPROJECT_API_KEY=xxx
