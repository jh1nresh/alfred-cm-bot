# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Bot Behavior Configuration
# Comma-separated list of channel IDs where the bot should respond
WATCH_CHANNEL_IDS=123456789,987654321

# Number of ✅ reactions needed to trigger payout logging
HELPFUL_REACTION_THRESHOLD=3

# On-Chain Payout Configuration (optional - enables on-chain payouts when set)
CONTRACT_ADDRESS=       # CMTreasury contract address
BOT_PRIVATE_KEY=        # Bot wallet private key for signing payout txs
BASE_RPC_URL=https://mainnet.base.org

# Deployment Configuration (for contract deployment)
PRIVATE_KEY=            # Deployer wallet private key
BASE_SEPOLIA_RPC=https://sepolia.base.org
